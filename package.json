{
  "name": "ai-writing-detector",
  "version": "0.1.0",
  "description": "A CLI tool that detects AI-generated writing using rule-based text analysis",
  "author": "",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@types/commander": "^2.12.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^8.57.1",
    "prettier": "^3.5.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  }
}
